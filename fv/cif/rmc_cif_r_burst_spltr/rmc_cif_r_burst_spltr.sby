# rmc_cif_r_burst_spltr formal run. Run from fv/ (paths relative to it): make rspltr [T=<task>]
#
# task = <config>_<mode>
#   config  d4    ROB_DEPTH=4 QUEUE_DEPTH=4 MAX_PKTS=16 N_SLOTS=16 AXI_IDW=4  small pow-2 ring
#           d2    ROB_DEPTH=2 QUEUE_DEPTH=2 MAX_PKTS=8  N_SLOTS=8  AXI_IDW=2  tightest ring
#           full  RTL defaults (32 / 32 / 64 / 64 / 8)
#   mode    prove unbounded proof of every assert (k-induction)
#           cover a trace for every cover
#           bmc   bounded check from reset
#
# QUEUE_DEPTH must stay a power of 2 (the ring wrap relies on it).

[tasks]
d4_prove   d4 prove
d4_cover   d4 cover
d4_bmc     d4 bmc
d2_prove   d2 prove
full_prove full prove

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 40
bmc:   mode bmc
bmc:   depth 6

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
d4:   read_slang --top rmc_cif_r_burst_spltr --no-implicit-memories -D FORMAL -G ROB_DEPTH=4 -G QUEUE_DEPTH=4 -G MAX_PKTS=16 -G N_SLOTS=16 -G AXI_IDW=4 rmc_cfg_pkg.sv rmc_cif_addrmap.sv rmc_cif_r_burst_spltr_ch.sv rmc_cif_r_burst_spltr.sv rmc_cif_r_burst_spltr_fv.sv rmc_cif_r_burst_spltr_bind.sv
d2:   read_slang --top rmc_cif_r_burst_spltr --no-implicit-memories -D FORMAL -G ROB_DEPTH=2 -G QUEUE_DEPTH=2 -G MAX_PKTS=8  -G N_SLOTS=8  -G AXI_IDW=2 rmc_cfg_pkg.sv rmc_cif_addrmap.sv rmc_cif_r_burst_spltr_ch.sv rmc_cif_r_burst_spltr.sv rmc_cif_r_burst_spltr_fv.sv rmc_cif_r_burst_spltr_bind.sv
full: read_slang --top rmc_cif_r_burst_spltr --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_addrmap.sv rmc_cif_r_burst_spltr_ch.sv rmc_cif_r_burst_spltr.sv rmc_cif_r_burst_spltr_fv.sv rmc_cif_r_burst_spltr_bind.sv
prep -top rmc_cif_r_burst_spltr
# async-reset flops -> sync model (single clock, reset sampled on aclk)
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/rmc_cif_addrmap.sv
../rtl/cif/rmc_cif_r_burst_spltr_ch.sv
../rtl/cif/rmc_cif_r_burst_spltr.sv
cif/rmc_cif_r_burst_spltr/rmc_cif_r_burst_spltr_fv.sv
cif/rmc_cif_r_burst_spltr/rmc_cif_r_burst_spltr_bind.sv
