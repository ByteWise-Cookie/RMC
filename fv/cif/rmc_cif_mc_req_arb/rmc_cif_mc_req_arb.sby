# rmc_cif_mc_req_arb formal run. From fv/:  make mcarb [T=<task>]
#   config  full RTL defaults (widths from the package / cif)
#   mode    prove / cover / bmc

[tasks]
full_prove full prove
full_cover full cover
full_bmc   full bmc

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 20
bmc:   mode bmc
bmc:   depth 20

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
full: read_slang --top rmc_cif_mc_req_arb --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_mc_req_arb.sv rmc_cif_mc_req_arb_fv.sv rmc_cif_mc_req_arb_bind.sv
prep -top rmc_cif_mc_req_arb
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/cif_utils/rmc_cif_mc_req_arb.sv
cif/rmc_cif_mc_req_arb/rmc_cif_mc_req_arb_fv.sv
cif/rmc_cif_mc_req_arb/rmc_cif_mc_req_arb_bind.sv
