# rmc_cif_w_burst_spltr formal run. From fv/:  make wspltr [T=<task>]
#   config  d4 ROB_DEPTH=4 MAX_PKTS=4 AXI_IDW=4 ; full RTL defaults
#   mode    prove / cover / bmc

[tasks]
d4_prove   d4 prove
d4_cover   d4 cover
d4_bmc     d4 bmc
full_prove full prove

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 30
bmc:   mode bmc
bmc:   depth 25

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
d4:   read_slang --top rmc_cif_w_burst_spltr --no-implicit-memories -D FORMAL -G ROB_DEPTH=4 -G MAX_PKTS=4 -G AXI_IDW=4 rmc_cfg_pkg.sv rmc_cif_addrmap.sv rmc_cif_w_burst_spltr.sv rmc_cif_w_burst_spltr_fv.sv rmc_cif_w_burst_spltr_bind.sv
full: read_slang --top rmc_cif_w_burst_spltr --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_addrmap.sv rmc_cif_w_burst_spltr.sv rmc_cif_w_burst_spltr_fv.sv rmc_cif_w_burst_spltr_bind.sv
prep -top rmc_cif_w_burst_spltr
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/cif_utils/rmc_cif_addrmap.sv
../rtl/cif/write_path/rmc_cif_w_burst_spltr.sv
cif/rmc_cif_w_burst_spltr/rmc_cif_w_burst_spltr_fv.sv
cif/rmc_cif_w_burst_spltr/rmc_cif_w_burst_spltr_bind.sv
