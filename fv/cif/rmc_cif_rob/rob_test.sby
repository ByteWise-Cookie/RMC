# rob_test formal run: read ROB + write ROB side by side, the rmc_cif_rob
# checker bound into both. Run from fv/:  make robtest [T=<task>]
#
#   d4    ROB_DEPTH=4 MAX_PKTS=4 AXI_IDW=4
#   full  RTL defaults (32 / 16 / 8)

[tasks]
d4_prove   d4 prove
d4_cover   d4 cover
d4_bmc     d4 bmc
full_prove full prove

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 40
bmc:   mode bmc
bmc:   depth 25

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
d4:   read_slang --top rob_test --no-implicit-memories -D FORMAL -G ROB_DEPTH=4 -G MAX_PKTS=4 -G AXI_IDW=4 rmc_cfg_pkg.sv rmc_cif_rob.sv rob_test.sv rmc_cif_rob_fv.sv rmc_cif_rob_bind.sv
full: read_slang --top rob_test --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_rob.sv rob_test.sv rmc_cif_rob_fv.sv rmc_cif_rob_bind.sv
prep -top rob_test
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/rmc_cif_rob.sv
../tb/tests/module_level/rob/rob_test.sv
cif/rmc_cif_rob/rmc_cif_rob_fv.sv
cif/rmc_cif_rob/rmc_cif_rob_bind.sv
