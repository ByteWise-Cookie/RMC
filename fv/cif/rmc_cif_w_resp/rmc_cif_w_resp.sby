# rmc_cif_w_resp formal run. From fv/:  make wresp [T=<task>]
#   config  i4 AXI_IDW=4 ; full RTL default (AXI_IDW=8)
#   mode    prove / cover / bmc

[tasks]
i4_prove   i4 prove
i4_cover   i4 cover
i4_bmc     i4 bmc
full_prove full prove

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 20
bmc:   mode bmc
bmc:   depth 20

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
i4:   read_slang --top rmc_cif_w_resp --no-implicit-memories -D FORMAL -G AXI_IDW=4 rmc_cfg_pkg.sv rmc_cif_w_resp.sv rmc_cif_w_resp_fv.sv rmc_cif_w_resp_bind.sv
full: read_slang --top rmc_cif_w_resp --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_w_resp.sv rmc_cif_w_resp_fv.sv rmc_cif_w_resp_bind.sv
prep -top rmc_cif_w_resp
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/write_path/rmc_cif_w_resp.sv
cif/rmc_cif_w_resp/rmc_cif_w_resp_fv.sv
cif/rmc_cif_w_resp/rmc_cif_w_resp_bind.sv
