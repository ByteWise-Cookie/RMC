# rmc_cif_r_resp formal run. Run from fv/ (paths are relative to it):  make rresp [T=<task>]
#
# task = <config>_<mode>
#   config  s     N_RDB=8  AXI_IDW=4   small, power-of-2 slot ring
#           full  RTL defaults (64 / 8)
#   mode    prove  unbounded proof of every assert (k-induction)
#           cover  a trace for every cover
#           bmc    bounded check from reset

[tasks]
s_prove    s prove
s_cover    s cover
s_bmc      s bmc
full_prove full prove

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 40
bmc:   mode bmc
bmc:   depth 12

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
s:    read_slang --top rmc_cif_r_resp --no-implicit-memories -D FORMAL -G AXI_IDW=4 -G N_RDB=8 rmc_cfg_pkg.sv rmc_cif_r_resp.sv rmc_cif_r_resp_fv.sv rmc_cif_r_resp_bind.sv
full: read_slang --top rmc_cif_r_resp --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_r_resp.sv rmc_cif_r_resp_fv.sv rmc_cif_r_resp_bind.sv
prep -top rmc_cif_r_resp
# async-reset flops -> sync model (single clock, reset sampled on aclk)
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/read_path/rmc_cif_r_resp.sv
cif/rmc_cif_r_resp/rmc_cif_r_resp_fv.sv
cif/rmc_cif_r_resp/rmc_cif_r_resp_bind.sv
