# rmc_cif_rrob formal run. Run from fv/ (paths are relative to it):  make rrob [T=<task>]
#
# task = <config>_<mode>
#   config  d4    ROB_DEPTH=4 MAX_PKTS=4 AXI_IDW=4 N_SLOTS=4   small, power-of-2 ring
#           d3    ROB_DEPTH=3 MAX_PKTS=2 AXI_IDW=2 N_SLOTS=4   non power-of-2 wrap
#           full  RTL defaults (32 / 64 / 8 / 32)
#   mode    prove  unbounded proof of every assert (k-induction)
#           cover  a trace for every cover
#           bmc    bounded check from reset
#           live   prove + cover with the fairness assumptions (bounded liveness)

[tasks]
d4_prove   d4 prove
d4_cover   d4 cover
d4_bmc     d4 bmc
d4_live    d4l prove
d4_livecov d4l cover
d3_live    d3l prove
full_live  fulll prove
d3_prove   d3 prove
d3_cover   d3 cover
full_prove full prove

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 40
bmc:   mode bmc
bmc:   depth 25

[engines]
smtbmc bitwuzla

[script]
plugin -i slang
d4l:  read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL -D FV_LIVE -G ROB_DEPTH=4 -G MAX_PKTS=4 -G AXI_IDW=4 -G N_SLOTS=4 rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
d3l:  read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL -D FV_LIVE -G ROB_DEPTH=3 -G MAX_PKTS=2 -G AXI_IDW=2 -G N_SLOTS=4 rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
fulll: read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL -D FV_LIVE rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
d4:   read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL -G ROB_DEPTH=4 -G MAX_PKTS=4 -G AXI_IDW=4 -G N_SLOTS=4 rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
d3:   read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL -G ROB_DEPTH=3 -G MAX_PKTS=2 -G AXI_IDW=2 -G N_SLOTS=4 rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
full: read_slang --top rmc_cif_rrob --no-implicit-memories -D FORMAL rmc_cfg_pkg.sv rmc_cif_rrob.sv rmc_cif_rrob_fv.sv rmc_cif_rrob_bind.sv
prep -top rmc_cif_rrob
# async-reset flops -> sync model (single clock, reset sampled on aclk)
async2sync

[files]
../rtl/rtl_pkg_config/rmc_cfg_pkg.sv
../rtl/cif/rmc_cif_rrob.sv
cif/rmc_cif_rrob/rmc_cif_rrob_fv.sv
cif/rmc_cif_rrob/rmc_cif_rrob_bind.sv
